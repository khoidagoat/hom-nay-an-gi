# ==============================================================================
# BIẾN MÔI TRƯỜNG WEB APP "HÔM NAY ĂN GÌ?" & DATA PIPELINE
# Copy file này thành .env.local và điền các giá trị thực tế
# ==============================================================================

# 1. Cấu hình Supabase (Combo 0đ vận hành)
# Lấy từ Project Settings -> API trên dashboard https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service Role Key dùng cho Data Pipeline nạp dữ liệu (KHÔNG để lộ ra client frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Google Gemini API (Free Tier: 15 RPM, 1500 RPD - Làm giàu dữ liệu quán ăn)
# Lấy miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# 3. Base URL cho tính năng chia sẻ link phòng (Chốt kèo nhóm)
NEXT_PUBLIC_APP_URL=http://localhost:3000

