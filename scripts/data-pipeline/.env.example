# ==============================================================================
# DATA PIPELINE: CẤU HÌNH BIẾN MÔI TRƯỜNG
# (Hoặc cấu hình trực tiếp trong file .env.local ở thư mục gốc dự án)
# ==============================================================================

# 1. Google Gemini API (Model: gemini-2.5-flash)
# Đăng ký nhận API key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# 2. Supabase Connection (Dùng cho Bước 3 nạp dữ liệu)
# Lấy từ Project Settings -> API trên dashboard https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Ưu tiên Service Role Key để bypass RLS khi nạp dữ liệu pipeline
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
